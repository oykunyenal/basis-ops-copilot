{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Landscape": {
    "Systems": [
      { "Sid": "DEV", "Role": "Development" },
      { "Sid": "QAS", "Role": "Quality" },
      { "Sid": "PRD", "Role": "Production" }
    ]
  },
  "Sap": {
    "BaseAddress": "http://fakesap"
  },
  "HealthScan": {
    "ScanIntervalSeconds": 60
  },
  "Executor": {
    "PollIntervalSeconds": 2,
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:05",
    "MaxRetryDelay": "00:02:00",
    "CircuitOpenDelay": "00:00:15",
    "ExecutionLease": "00:02:00"
  }
}
